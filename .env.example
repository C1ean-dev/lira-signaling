# Server only. Copy these values into your Render environment configuration.

# Cloudflare TURN credentials
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# GitHub issue reporting (issuesReporter)
GITHUB_REPORT_TOKEN=
GITHUB_REPO=C1ean-dev/Lira

# Native libp2p catalog and WSS relay (requires the bundled Rust executable).
# RENDER_EXTERNAL_HOSTNAME supplies the public address automatically on Render.
# Node reuses GITHUB_RELEASES_TOKEN / GITHUB_REPORT_TOKEN / GITHUB_TOKEN.
# The selected token needs Contents: Read on C1ean-dev/lira-clean.
# Optional separate credential:
LIRA_RELAY_SOURCE_TOKEN=
LIRA_P2P_CATALOG_FILE=.lira-p2p/catalog.json
# Optional override; Node finds the compiled binary automatically.
# LIRA_P2P_RELAY_BIN=/usr/local/bin/lira-p2p-node
LIRA_P2P_RELAY_DATA=.lira-p2p/relay
LIRA_P2P_RELAY_LISTEN=/ip4/127.0.0.1/tcp/9001/ws
LIRA_P2P_RELAY_UPSTREAM=ws://127.0.0.1:9001/
# Other providers may set these explicitly:
# LIRA_P2P_RELAY_ADVERTISE=/dns4/relay.example.com/tcp/443/tls/x-parity-ws/%2Fp2p%2Frelay
# LIRA_P2P_CATALOG_URL=https://relay.example.com/p2p/catalog/v1
# LIRA_P2P_FEDERATE_RENDER=false
