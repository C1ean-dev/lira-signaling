# Server only. Copy these values into your Northflank, Docker or Render environment configuration.

# Optional public origin override. On Render (RENDER_EXTERNAL_HOSTNAME) and
# Koyeb (KOYEB_PUBLIC_DOMAIN), the public domain is detected automatically.
# PUBLIC_BASE_URL=https://lira-signaling.example.com

# Cloudflare TURN credentials
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# GitHub issue reporting (issuesReporter)
GITHUB_REPORT_TOKEN=
GITHUB_REPO=C1ean-dev/Lira

# Optional update publisher secret for POST /updates/lira/refresh
# LIRA_UPDATE_PUBLISH_TOKEN=
# Optional fallback to stream lira-clean installers instead of 302 redirecting:
# LIRA_NATIVE_UPDATES_PROXY=1

# Native libp2p catalog and WSS relay (requires the bundled Rust executable).
# RENDER_EXTERNAL_HOSTNAME / KOYEB_PUBLIC_DOMAIN supply the public address automatically.
# Render reuses GITHUB_RELEASES_TOKEN / GITHUB_REPORT_TOKEN / GITHUB_TOKEN.
# Docker/Koyeb builds compile the Rust relay when LIRA_RELAY_SOURCE_TOKEN is set
# (or when LIRA_BUILD_RELAY=1 with one of the GITHUB_* tokens). Set LIRA_BUILD_RELAY=0
# to skip Rust compilation during Docker builds.
LIRA_RELAY_SOURCE_TOKEN=
# LIRA_BUILD_RELAY=1
LIRA_P2P_CATALOG_FILE=.lira-p2p/catalog.json
# Optional override; Node finds the compiled binary automatically.
# LIRA_P2P_RELAY_BIN=/usr/local/bin/lira-p2p-node
LIRA_P2P_RELAY_DATA=.lira-p2p/relay
LIRA_P2P_RELAY_LISTEN=/ip4/127.0.0.1/tcp/9001/ws
LIRA_P2P_RELAY_UPSTREAM=ws://127.0.0.1:9001/
# Other providers may set these explicitly:
# LIRA_P2P_RELAY_ADVERTISE=/dns4/relay.example.com/tcp/443/tls/x-parity-ws/%2Fp2p%2Frelay
# LIRA_P2P_CATALOG_URL=https://relay.example.com/p2p/catalog/v1
# LIRA_P2P_FEDERATE_RENDER=false
